{
  "rules": {
    ".read": false,
    ".write": false,
    "krathongs": {
      ".read": true,
      ".write": true,
      "$id": {
        ".validate": "$id.matches(/^[A-Za-z0-9_-]{6,64}$/) && newData.hasChildren(['name', 'img', 'at'])",
        "name": {
          ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
        },
        "img": {
          ".validate": "newData.isString() && newData.val().length < 700000 && (newData.val().beginsWith('data:image/png;base64,') || newData.val().beginsWith('data:image/webp;base64,'))"
        },
        "status": {
          ".validate": "newData.isString() && newData.val().length <= 20"
        },
        "lucky": {
          ".validate": "newData.isBoolean()"
        },
        "luckyRank": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "at": {
          ".validate": "newData.isNumber() && newData.val() <= now"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "draw": {
      ".read": true,
      ".write": true
    }
  }
}
